  "source_reviewed_categories": {
    "registered_single_directive": {
      "source_basis": "Application resources/macros/blade.php registers canonical/shareImage/title as one-shot custom directives. AppServiceProvider calls bootMacros, which requires that source. This is source evidence of registration, not execution proof.",
      "grammar_limitation": "Unknown _custom directives are required to have an @end... partner; canonical and shareImage are absent from the inline-directive table.",
      "validity": "declared application syntax; runtime activation is not claimed",
      "evidence": [
        "app_macros",
        "app_provider",
        "grammar_custom",
        "framework_statement_dispatch"
      ]
    },
    "registered_error_override": {
      "source_basis": "Application resources/macros/blade.php overrides error with a one-shot echo; these uses therefore have no @enderror.",
      "grammar_limitation": "CONDITIONAL_SPECS hardcodes @error/@enderror and cannot inspect application directive overrides.",
      "validity": "declared application syntax; runtime registration is outside profile",
      "evidence": [
        "app_macros",
        "app_provider",
        "grammar_conditionals",
        "framework_statement_dispatch"
      ]
    },
    "literal_at_text": {
      "source_basis": "Email addresses and the twitter handle occur in ordinary quoted HTML attributes/text, rather than template directives.",
      "grammar_limitation": "Grammar generic @word custom-block parsing reports errors for literal @ content. BladeCompiler only compiles recognized/custom statements; other statements remain text. Its matcher also uses a non-word-boundary guard.",
      "validity": "ordinary template text/attribute syntax",
      "evidence": [
        "grammar_custom",
        "framework_statement_dispatch"
      ]
    },
    "conditional_html_structure": {
      "source_basis": "The template opens HTML elements inside branches and closes them outside those branches, or emits different openings in mutually exclusive branches.",
      "grammar_limitation": "The grammar inherits a statically nested HTML element tree; Laravel Blade conditionals compile to PHP conditionals without requiring static HTML-tree balancing.",
      "validity": "source-level conditional template structure; no branch execution or rendered-markup validity claim",
      "evidence": [
        "grammar_html",
        "framework_conditionals"
      ]
    },
    "dynamic_html_tag": {
      "source_basis": "The template writes opening and closing tag names with a Blade echo of a supplied tag variable.",
      "grammar_limitation": "Inherited HTML scanner requires a static tag_name; the Blade echo is not a tag name in that grammar.",
      "validity": "Blade echo syntax; runtime tag value and output markup are not claimed",
      "evidence": [
        "grammar_html",
        "framework_echo"
      ]
    },
    "quoted_at_attribute_payload": {
      "source_basis": "A single-quoted component attribute holds literal Alpine-style @click text and double-quoted JavaScript payload.",
      "grammar_limitation": "The @ token is interpreted as a Blade conditional within quoted-attribute parsing; the application passes the attribute payload as literal markup elsewhere.",
      "validity": "quoted attribute syntax; no client execution claim",
      "evidence": [
        "grammar_attributes",
        "framework_statement_dispatch"
      ]
    },
    "extension_directive_in_attribute": {
      "source_basis": "Livewire v4.4.8 pinned by composer.lock explicitly registers entangle; the template uses it inside x-data.",
      "grammar_limitation": "The grammar inline-directive table does not include entangle, and generic custom conditionals are not an adequate attribute expression model.",
      "validity": "declared extension syntax at the pinned source; provider activation is outside profile",
      "evidence": [
        "livewire_entangle",
        "grammar_attributes"
      ]
    },
    "directive_case_variant": {
      "source_basis": "The source closes @guest with @endGuest. BladeCompiler dispatches compileEndGuest through PHP method lookup; the grammar requires literal lowercase @endguest.",
      "grammar_limitation": "Literal directive tokens are case-sensitive while compiler method lookup accepts this case variant.",
      "validity": "source/compiler correspondence; not a template execution witness",
      "evidence": [
        "grammar_conditionals",
        "framework_statement_dispatch",
        "framework_conditionals"
      ],
      "synthetic_language_check": "PHP method_exists(SyntheticBladeScope::class,\"compileendGuest\") returns true for declared protected compileEndGuest; only synthetic class executed, no framework/application source executed."
    },
    "nested_component_blocks": {
      "source_basis": "The source contains nested, paired @component blocks, with @slot blocks in the vendor mail layout. Source openings and endings are balanced.",
      "grammar_limitation": "Pinned grammar has no dedicated @component rule, relying on generic custom conditional blocks and wildcard @end... endings; it synthesizes a missing end at EOF for these nested sources.",
      "validity": "balanced component syntax admitted by the pinned compiler source; rendering external mail views remains outside profile",
      "evidence": [
        "grammar_custom",
        "framework_components"
      ]
    }
