#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rbconfig'
def setup_error(message)
  warn message
  exit 2
end

if RbConfig::CONFIG['prefix'].start_with?('/System/Library/Frameworks/Ruby.framework')
  candidates = ['mise', '/opt/homebrew/bin/mise', File.expand_path('~/.local/bin/mise')].map do |mise|
    begin
      IO.popen([mise, 'which', 'ruby'], err: File::NULL) { |io| io.read }.strip
    rescue Errno::ENOENT
      nil
    end
  end
  candidates << File.expand_path('~/.local/share/mise/installs/ruby/latest/bin/ruby')
  mise_ruby = candidates.find { |path| path && !path.empty? && File.executable?(path) }
  setup_error 'prepare-cpp-benchmark: prepare a mise Ruby before running this command' unless mise_ruby
  exec mise_ruby, File.expand_path(__FILE__), *ARGV
end

def install_and_require(*gem_names)
  missing = gem_names.reject do |name|
    require(name == 'rubyzip' ? 'zip' : name)
    true
  rescue LoadError
    false
  end
  return if missing.empty?

  setup_error "Missing gems: #{missing.join(', ')}; prepare dependencies before scripted use" unless ARGV.empty? && $stdin.tty?
  puts "Missing gems: #{missing.join(', ')}. Would you like to install them? (y/n)"
  setup_error "#{missing.join(', ')} required for this script. Exiting." unless $stdin.gets.to_s.chomp.downcase == "y"
  system("gem", "install", *missing) or setup_error('gem install failed')
  Gem.clear_paths
  missing.each { |name| require(name == 'rubyzip' ? 'zip' : name) }
end

install_and_require "tty-option", "tty-prompt", "tty-command"

require_relative 'prepare-cpp-benchmark.d/preparation'

class PrepareCppBenchmarkCommand
  include TTY::Option
  usage do
    program 'prepare-cpp-benchmark'
    no_command
    desc 'Prepare the pinned public C++ source profile and explicit macOS operator without executing application code.'
    example 'bin/prepare-cpp-benchmark --repo /local/double-conversion --clangd /local/llvm/bin/clangd --sdk /local/sdk --resource /local/llvm/lib/clang/23 --cxx /local/llvm/include/c++/v1 --cache-directory /local/dyld --cache-prefix dyld_shared_cache_arm64e --out /local/new-profile'
  end
  %i[repo clangd sdk resource cxx cache_directory cache_prefix out].each do |key|
    option(key) { long "--#{key.to_s.tr('_', '-')} PATH"; desc "#{key.to_s.tr('_', ' ').capitalize} (required)" }
  end
  flag(:help) { short '-h'; long '--help'; desc 'Show help' }
end

command = PrepareCppBenchmarkCommand.new
command.parse
unless command.params.valid?
  warn command.help
  exit 2
end
if command.params[:help]
  puts command.help
  exit 0
end
if ARGV.empty? && !$stdin.tty?
  warn command.help
  exit 2
end
options = command.params.to_h
keys = %i[repo clangd sdk resource cxx cache_directory cache_prefix out]
if ARGV.empty? && $stdin.tty?
  prompt = TTY::Prompt.new
  keys.each { |key| options[key] = prompt.ask("#{key}:", required: true) }
end
begin
  keys.each { |key| raise ArgumentError, "--#{key.to_s.tr('_', '-')} is required" unless options[key] }
  puts JSON.generate(CppBenchmarkPreparation.new.run(**options.slice(*keys)))
rescue StandardError => error
  warn "prepare-cpp-benchmark: #{error.message}"
  exit 2
end
