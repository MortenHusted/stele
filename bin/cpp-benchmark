#!/usr/bin/env ruby
# frozen_string_literal: true

%w[tty-option tty-prompt tty-command].each do |name|
  require name
rescue LoadError
  abort "Missing #{name}. Install dependencies first: gem install tty-option tty-prompt tty-command"
end
require_relative 'cpp-benchmark.d/score'

class BenchmarkCommand
  include TTY::Option
  usage do
    program 'cpp-benchmark'
    no_command
    desc 'Extract or validate a canonical C++ snapshot and score an independently pinned oracle.'
    example 'bin/cpp-benchmark --repo REPO --profile CONFIG --stele BIN --oracle ORACLE --oracle-sha256 SHA --anchors ANCHORS --anchors-sha256 SHA --out-dir NEW_DIR'
    example 'bin/cpp-benchmark --stele BIN --oracle ORACLE --oracle-sha256 SHA --anchors ANCHORS --anchors-sha256 SHA --snapshot SNAPSHOT --out-dir NEW_DIR'
  end
  %i[repo profile stele oracle oracle_sha256 anchors anchors_sha256 snapshot out_dir].each do |name|
    option(name) { long "--#{name.to_s.tr('_', '-')} VALUE"; desc(name == :snapshot ? 'Score an existing snapshot instead of extracting' : "#{name.to_s.tr('_', ' ').capitalize} (#{%i[repo profile].include?(name) ? 'extraction only' : 'required'})") }
  end
  flag(:help) { short '-h'; long '--help'; desc 'Show help' }
end

command = BenchmarkCommand.new
command.parse
if command.params[:help]
  puts command.help
  exit 0
end
if ARGV.empty? && !$stdin.tty?
  warn command.help
  exit 2
end
options = command.params.to_h
if ARGV.empty? && $stdin.tty?
  prompt = TTY::Prompt.new
  %i[repo profile stele oracle oracle_sha256 anchors anchors_sha256 out_dir].each { |key| options[key] = prompt.ask("#{key}:", required: true) }
end
begin
  required = %i[stele oracle oracle_sha256 anchors anchors_sha256 out_dir]
  required += %i[repo profile] unless options[:snapshot]
  required.each { |key| raise ArgumentError, "--#{key.to_s.tr('_', '-')} is required" unless options[key] }
  repo = File.realpath(options[:repo]) if options[:repo]
  output = File.expand_path(options[:out_dir])
  output = File.join(File.realpath(File.dirname(output)), File.basename(output))
  raise ArgumentError, 'output directory must stay outside the analyzed repository' if repo && (output == repo || output.start_with?("#{repo}/"))
  scorer = CppBenchmarkScore.new(oracle: options[:oracle], oracle_sha256: options[:oracle_sha256], anchors: options[:anchors], anchors_sha256: options[:anchors_sha256])
  runner = TTY::Command.new(printer: :null)
  unless options[:snapshot]
    commit = runner.run('git', '-C', repo, 'rev-parse', 'HEAD').out.strip
    raise ArgumentError, 'repository does not match oracle commit' unless commit == scorer.commit
    raise ArgumentError, 'profile must be a prepared file' unless File.file?(options[:profile])
  end
  binary = File.realpath(options[:stele])
  raise ArgumentError, 'stele must be executable' unless File.executable?(binary)
  Dir.mkdir(output)
  snapshot_path = File.join(output, 'snapshot.json')
  if options[:snapshot]
    File.open(snapshot_path, File::WRONLY | File::CREAT | File::EXCL) { |file| file.write(File.binread(options[:snapshot])) }
  else
    runner.run(binary, 'code', 'extract', '--path', repo, '--language', 'cpp', '--calls', 'required', '--cpp-profile', File.realpath(options[:profile]), '--out', snapshot_path)
  end
  snapshot_bytes = File.binread(snapshot_path)
  runner.run(binary, 'code', 'validate', '--file', snapshot_path)
  raise ArgumentError, 'snapshot changed during validation' unless File.binread(snapshot_path) == snapshot_bytes
  report = scorer.score(JSON.parse(snapshot_bytes))
  report['snapshot_sha256'] = Digest::SHA256.hexdigest(snapshot_bytes)
  report['codemap_sha256'] = Digest::SHA256.file(binary).hexdigest
  File.open(File.join(output, 'report.json'), File::WRONLY | File::CREAT | File::EXCL) { |file| file.write(JSON.pretty_generate(report) + "\n") }
  puts "Frozen canonical oracle gates: #{report['passed'] ? 'PASS' : 'FAIL'}"
  exit(report['passed'] ? 0 : 1)
rescue StandardError => error
  warn "cpp-benchmark: #{error.message}"
  exit 2
end
