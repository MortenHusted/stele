#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rbconfig'
def setup_error(message)
  warn message
  exit 2
end

if RbConfig::CONFIG['prefix'].start_with?('/System/Library/Frameworks/Ruby.framework')
  candidates = ['mise', '/opt/homebrew/bin/mise', File.expand_path('~/.local/bin/mise')].map do |mise|
    begin
      IO.popen([mise, 'which', 'ruby'], err: File::NULL) { |io| io.read }.strip
    rescue Errno::ENOENT
      nil
    end
  end
  candidates << File.expand_path('~/.local/share/mise/installs/ruby/latest/bin/ruby')
  mise_ruby = candidates.find { |path| path && !path.empty? && File.executable?(path) }
  setup_error 'package-release: prepare a mise Ruby before running this command' unless mise_ruby
  exec mise_ruby, File.expand_path(__FILE__), *ARGV
end

def install_and_require(*gem_names)
  missing = gem_names.reject do |name|
    require name
    true
  rescue LoadError
    false
  end
  return if missing.empty?

  setup_error "Missing gems: #{missing.join(', ')}; prepare dependencies before scripted use" unless ARGV.empty? && $stdin.tty?
  puts "Missing gems: #{missing.join(', ')}. Would you like to install them? (y/n)"
  setup_error "#{missing.join(', ')} required for this script. Exiting." unless $stdin.gets.to_s.chomp.downcase == "y"
  system("gem", "install", *missing) or setup_error('gem install failed')
  Gem.clear_paths
  missing.each { |name| require name }
end

install_and_require "tty-option", "tty-prompt", "tty-command"

require_relative 'package-release.d/package'

class PackageReleaseCommand
  include TTY::Option
  usage do
    program 'package-release'
    no_command
    desc 'Build Stele with remapped builder paths and package its pinned dependency notices. Executes only the owned build and version check.'
    example 'bin/package-release --version 0.5.5 --target aarch64-apple-darwin --dist-dir /local/new-releases'
  end
  option(:version) { long '--version VERSION'; desc 'Must match the workspace version' }
  option(:target) { long '--target TRIPLE'; desc 'aarch64/x86_64 apple-darwin or unknown-linux-gnu' }
  option(:dist_dir) { long '--dist-dir PATH'; desc 'Output directory; defaults to dist/' }
  flag(:help) { short '-h'; long '--help'; desc 'Show help' }
end

command = PackageReleaseCommand.new
command.parse
unless command.params.valid?
  warn command.help
  exit 2
end
if command.params[:help]
  puts command.help
  exit 0
end
if ARGV.empty? && !$stdin.tty?
  warn command.help
  exit 2
end
options = command.params.to_h
if ARGV.empty? && $stdin.tty?
  prompt = TTY::Prompt.new
  options[:version] = prompt.ask('Workspace version:', required: true)
  options[:target] = prompt.select('Target:', ReleasePackage::TARGETS)
end
begin
  %i[version target].each { |key| raise ArgumentError, "--#{key} is required" unless options[key] }
  puts JSON.generate(ReleasePackage.new.run(**options.slice(:version, :target, :dist_dir)))
rescue StandardError => error
  warn "package-release: #{error.message}"
  exit 2
end
