#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rbconfig'
def setup_error(message)
  warn message
  exit 2
end

if RbConfig::CONFIG['prefix'].start_with?('/System/Library/Frameworks/Ruby.framework')
  candidates = ['mise', '/opt/homebrew/bin/mise', File.expand_path('~/.local/bin/mise')].map do |mise|
    begin
      IO.popen([mise, 'which', 'ruby'], err: File::NULL) { |io| io.read }.strip
    rescue Errno::ENOENT
      nil
    end
  end
  candidates << File.expand_path('~/.local/share/mise/installs/ruby/latest/bin/ruby')
  mise_ruby = candidates.find { |path| path && !path.empty? && File.executable?(path) }
  setup_error 'prepare-js-ts: prepare a mise Ruby before running this command' unless mise_ruby
  exec mise_ruby, File.expand_path(__FILE__), *ARGV
end

def install_and_require(*gem_names)
  missing = gem_names.reject do |name|
    require name
    true
  rescue LoadError
    false
  end
  return if missing.empty?

  setup_error "Missing gems: #{missing.join(', ')}; prepare dependencies before scripted use" unless ARGV.empty? && $stdin.tty?
  puts "Missing gems: #{missing.join(', ')}. Would you like to install them? (y/n)"
  setup_error "#{missing.join(', ')} required for this script. Exiting." unless $stdin.gets.to_s.chomp.downcase == "y"
  system("gem", "install", *missing) or setup_error('gem install failed')
  Gem.clear_paths
  missing.each { |name| require name }
end

install_and_require "tty-option", "tty-prompt", "tty-command"

require_relative 'prepare-js-ts.d/preparation'

class PrepareJsTsCommand
  include TTY::Option
  usage do
    program 'prepare-js-ts'
    no_command
    desc 'Verify frozen public Excalidraw inputs and write a local environment with explicit operator runtime pins.'
    example 'bin/prepare-js-ts --repo /local/excalidraw --bundle /local/compiler --runtime /local/runtime.json --out /local/new-inputs'
  end
  option(:repo) { long '--repo PATH'; desc 'Clean public Excalidraw checkout with pinned Yarn dependencies prepared' }
  option(:bundle) { long '--bundle PATH'; desc 'Prepared canonical Node/TypeScript operator bundle' }
  option(:runtime) { long '--runtime PATH'; desc 'Explicit operator runtime profile; passed through unchanged' }
  option(:out) { long '--out PATH'; desc 'New output directory outside Git' }
  flag(:help) { short '-h'; long '--help'; desc 'Show help' }
end

command = PrepareJsTsCommand.new
command.parse
unless command.params.valid?
  warn 'prepare-js-ts: invalid arguments; see --help'
  exit 2
end
if command.params[:help]
  puts command.help
  exit 0
end
options = command.params.to_h
if ARGV.empty? && $stdin.tty?
  prompt = TTY::Prompt.new
  %i[repo bundle runtime out].each { |key| options[key] = prompt.ask("#{key}:", required: true) }
end
begin
  %i[repo bundle runtime out].each { |key| raise ArgumentError, "--#{key} is required" unless options[key] }
  puts JSON.generate(JsTsPreparation.new.run(**options.slice(:repo, :bundle, :runtime, :out)))
rescue StandardError => error
  warn "prepare-js-ts: #{error.message}"
  exit 2
end
