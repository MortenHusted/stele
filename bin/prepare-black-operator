#!/usr/bin/env ruby
# frozen_string_literal: true

require 'rbconfig'
def setup_error(message)
  warn message
  exit 2
end

if RbConfig::CONFIG['prefix'].start_with?('/System/Library/Frameworks/Ruby.framework')
  candidates = ['mise', '/opt/homebrew/bin/mise', File.expand_path('~/.local/bin/mise')].map do |mise|
    begin
      IO.popen([mise, 'which', 'ruby'], err: File::NULL) { |io| io.read }.strip
    rescue Errno::ENOENT
      nil
    end
  end
  candidates << File.expand_path('~/.local/share/mise/installs/ruby/latest/bin/ruby')
  mise_ruby = candidates.find { |path| path && !path.empty? && File.executable?(path) }
  setup_error 'prepare-black-operator: prepare a mise Ruby before running this command' unless mise_ruby
  exec mise_ruby, File.expand_path(__FILE__), *ARGV
end

def install_and_require(*gem_names)
  missing = gem_names.reject do |name|
    require(name == 'rubyzip' ? 'zip' : name)
    true
  rescue LoadError
    false
  end
  return if missing.empty?

  setup_error "Missing gems: #{missing.join(', ')}; prepare dependencies before scripted use" unless ARGV.empty? && $stdin.tty?
  puts "Missing gems: #{missing.join(', ')}. Would you like to install them? (y/n)"
  setup_error "#{missing.join(', ')} required for this script. Exiting." unless $stdin.gets.to_s.chomp.downcase == "y"
  system("gem", "install", *missing) or setup_error('gem install failed')
  Gem.clear_paths
  missing.each { |name| require(name == 'rubyzip' ? 'zip' : name) }
end

install_and_require "tty-option", "tty-prompt", "tty-command", "rubyzip"

require_relative 'prepare-black-operator.d/preparation'

class PrepareBlackOperatorCommand
  include TTY::Option
  usage do
    program 'prepare-black-operator'
    no_command
    desc 'Prepare a closed Black compiler/runtime from pinned public archives and an explicitly selected host cache family. Executes no application or install scripts.'
    example 'bin/prepare-black-operator --archive /local/cpython.tar.gz --compiler /local/mypy --wheels /local/wheels --cache-directory /System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld --cache-prefix dyld_shared_cache_arm64e --out /local/new-operator'
  end
  option(:archive) { long '--archive PATH'; desc 'Pinned CPython archive from black-operator.json' }
  option(:compiler) { long '--compiler PATH'; desc 'Clean public mypy checkout at the declared commit' }
  option(:wheels) { long '--wheels PATH'; desc 'Directory containing the five pinned public wheels' }
  option(:cache_directory) { long '--cache-directory PATH'; desc 'Explicit host directory containing the complete dyld cache family' }
  option(:cache_prefix) { long '--cache-prefix NAME'; desc 'Explicit dyld family filename prefix, such as dyld_shared_cache_arm64e' }
  option(:out) { long '--out PATH'; desc 'New output directory outside Git' }
  flag(:help) { short '-h'; long '--help'; desc 'Show help' }
end

command = PrepareBlackOperatorCommand.new
command.parse
unless command.params.valid?
  warn 'prepare-black-operator: invalid arguments; see --help'
  exit 2
end
if command.params[:help]
  puts command.help
  exit 0
end
options = command.params.to_h
if ARGV.empty? && $stdin.tty?
  prompt = TTY::Prompt.new
  %i[archive compiler wheels cache_directory cache_prefix out].each { |key| options[key] = prompt.ask("#{key}:", required: true) }
end
begin
  %i[archive compiler wheels cache_directory cache_prefix out].each { |key| raise ArgumentError, "--#{key.to_s.tr('_', '-')} is required" unless options[key] }
  puts JSON.generate(BlackOperatorPreparation.new.run(**options.slice(:archive, :compiler, :wheels, :cache_directory, :cache_prefix, :out)))
rescue StandardError => error
  warn "prepare-black-operator: #{error.message}"
  exit 2
end
