    "original_absolute_session_deadline_enforced": true,
    "control_eof_and_failed_exit_rejected": true,
    "owned_group_cleanup_bounded": true,
    "complete_images_before_and_after": true,
    "changed_file_or_executable_mapping_witness_rejected": true,
    "repeat_dirty_and_independent_checkout_oracles_preserved": true,
    "original_darwin_runtime_and_semantic_identity_preserved": true
  },
  "throughput_candidate": {
