    "max_young_generation_mib": 192,
    "original_deadline_and_output_budgets_unchanged": true,
    "original_application_oracle_and_census_unchanged": true,
    "existing_total_memory_ceiling_unchanged": true,
    "keep_only_after_both_native_gates": true
  }
}
