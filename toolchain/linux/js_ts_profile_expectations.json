{
  "contract": "js-ts-linux-runtime-controls/1",
  "frozen_before_production_integration": true,
  "profile": {
    "legacy_darwin_json_preserved": true,
    "explicit_native_linux_profile": true,
    "wrong_architecture_rejected": true,
    "unsupported_host_rejected_before_capture": true,
    "anonymous_execution_allow_rejected": true,
    "non_node_selected_tool_rejected": true,
    "missing_or_changed_loader_rejected": true,
    "runtime_inside_source_rejected": true,
    "missing_empty_openssl_pin_rejected": true,
    "nonempty_openssl_configuration_rejected": true,
    "wrong_openssl_pin_role_rejected": true,
    "relocated_runtime_identity_equal": true,
    "runtime_kernel_guard_flags_and_limits_bound": true
  },
  "helper": {
    "actual_pinned_compiler_ready_result_exit": true,
    "original_canonical_oracle_and_census_unchanged": true,
    "application_source_never_executed": true,
    "captured_data_only_reads": true,
