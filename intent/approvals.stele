  text: "stele check prints the same report and exits the same way as running stele code evidence, stele code checker and stele spec check by hand."
}
approval {
  item: exit_status_contract
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:b1c6d005c86facade7ca0ac9944d1aea1ba7b735a3fc6d73b588e006495895db"
