  expect ae2_old_failures_are_not_red { query: "red(ae2_ex, C)" count: 0 }
  expect ae2_old_failures_do_not_spoil_new_passes { query: "green(ae2_ex, C)" count: 3 }
  expect ae2_examples_have_no_standing { query: "standing(ae2_ex, K)" count: 0 }
  expect ae2_def_has_5_reasons { query: "reason(ae2_def, R, S)" count: 5 }
  expect ae2_names_the_unapproved_example { query: "reason(ae2_def, example_awaits_approval, ae2_ex)" count: 1 }
  expect ae2_lacks_red_on_every_channel { query: "reason(ae2_def, no_failing_run, C)" count: 3 }
  expect ae2_names_the_digest_mismatch { query: "reason(ae2_def, run_digest_mismatch, ae2_ex)" count: 1 }
  expect ae2_intent_has_1_reasons { query: "reason(ae2_intent, R, S)" count: 1 }
  expect ae2_intent_names_its_definition { query: "reason(ae2_intent, unverified_member, ae2_def)" count: 1 }

