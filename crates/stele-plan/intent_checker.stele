// Which intents, domain definitions and exceptions are verified at the target
// source identity, and which are unapproved, stale or unverified, and why?
// Does the code contain every anchor a statement names as realizing it?
// This checker includes a synthetic fixture; check and bind replace it with
// the evidence `stele intent report` projects from a catalog, its examples,
// its approval log and its run ledger. `stele spec walk` and `stele spec
// mutate` on this file are the checker's self-test.
spec intent_checker {
  notes { text: "Mutation policies exercise the synthetic fixture only. Bound evidence drops them and carries its own invariant expectations: awaiting_approval(I) count 0, and standing(<id>, Kind) count 1 for every intent, definition and exception. Standing precedence is unapproved, stale, unverified, verified. Inequality against a constant is false in the engine when the constant appears in no fact, so rules compare only bound variables." }

  symbol intent { label: "Intent" }
  symbol definition { label: "Domain definition" }
  symbol exception { label: "Exception" }
  symbol channel { label: "Channel" }
  symbol example { label: "Example" }
  symbol approve { label: "Approve" }
  symbol holds_instead { label: "States what holds instead" }
  symbol pass { label: "Passed" }
  symbol fail { label: "Failed" }
  symbol error { label: "Errored or did not build" }
  symbol unapproved { label: "Unapproved" }
  symbol stale { label: "Stale" }
  symbol unverified { label: "Unverified" }
  symbol verified { label: "Verified" }
  symbol not_approved { label: "never approved, or re-added after an approved removal" }
  symbol text_differs { label: "text differs from its latest approval" }
  symbol removal_pending { label: "removed without an approved removal" }
  symbol link_removal_pending { label: "approved link removed without an approved removal" }
  symbol tag_removal_pending { label: "approved channel tag removed without an approved removal" }
  symbol linked_statement_changed { label: "a linked statement changed since this was approved" }
  symbol no_definition { label: "no definition refines it" }
  symbol unverified_member { label: "a definition or exception it requires is not verified" }
  symbol no_channel { label: "applies on no approved channel" }
  symbol no_example { label: "no example tagged for an applicable channel" }
  symbol no_failing_run { label: "an example has no failing run with its current text on this channel" }
  symbol no_passing_run { label: "an example does not pass cleanly at the target on this channel" }
  symbol exception_unsettled { label: "an exception naming this channel is unapproved or stale, so it does not scope the channel out" }
  symbol example_awaits_approval { label: "an example is unapproved or stale" }
  symbol run_digest_mismatch { label: "an example's failing runs were recorded for text it no longer has" }
  symbol dependent_removal_pending { label: "a dependent's link to it was removed without an approved removal" }

  // ================================================== evidence (projector contract)
  // Every relation in this section is asserted by the stele intent projector
  // and by nothing else. Identities and digests are relation arguments, never
  // observed bases. Digests and identities are symbols, quoted when they are
  // not bare identifiers.

  // A current catalog statement or tagged example. Kind is intent, definition, exception, channel or example.
  relation item { args: [symbol, symbol] roles: [item, kind] reads: "{item} is a current {kind}" }
  // The intent-digest of a current item's text, links, kind, exception kind, channel scope or test tokens.
  relation current_digest { args: [symbol, symbol] roles: [item, digest] reads: "{item} currently reads as {digest}" }
  // A current link from a definition to the intent it refines.
  relation refines { args: [symbol, symbol] roles: [definition, intent] reads: "{definition} refines {intent}" }
  // A current link from an exception to the definition it narrows.
  relation narrows { args: [symbol, symbol] roles: [exception, definition] reads: "{exception} narrows {definition}" }
  // A current exception's kind: does_not_apply or holds_instead.
  relation exception_kind { args: [symbol, symbol] roles: [exception, kind] reads: "{exception} is a {kind} exception" }
  // A channel named in a current exception's scope.
  relation scoped_to { args: [symbol, symbol] roles: [exception, channel] reads: "{exception} names the channel {channel}" }
  // A current example's tag naming the definition or holds-instead exception it exemplifies; tags the scanner ignores are not emitted.
  relation exemplifies { args: [symbol, symbol] roles: [example, statement] reads: "{example} exemplifies {statement}" }
  // A channel a current example is tagged to run on.
  relation tagged { args: [symbol, symbol] roles: [example, channel] reads: "{example} is tagged for {channel}" }
  // One approval-log entry. Position is its order in the log; action is approve or remove; digest is the item's digest.
  relation log_entry { args: [integer, symbol, symbol, symbol, symbol] roles: [position, item, kind, action, digest] reads: "approval entry {position} records {action} of {kind} {item} reading {digest}" }
  // A resolved link recorded by an entry, with the digest its target had then.
  relation log_link { args: [integer, symbol, symbol] roles: [position, target, digest] reads: "approval entry {position} recorded a link to {target} reading {digest}" }
  // A channel tag recorded by an example's entry.
  relation log_tag { args: [integer, symbol] roles: [position, channel] reads: "approval entry {position} recorded the channel tag {channel}" }
  // One recorded run. Outcome is pass, fail, error or skip.
  relation run { args: [symbol, symbol, symbol, symbol, symbol] roles: [example, digest, channel, identity, outcome] reads: "{example} reading {digest} ran on {channel} at source {identity} and ended {outcome}" }
  // The source identity the report evaluates.
  relation target_identity { args: [symbol] roles: [identity] reads: "{identity} is the target source identity" }
  // An anchor a current definition or exception names as the code that realizes it: a symbol key or a repository path. Not approved, so it never changes a standing.
  relation realized { args: [symbol, symbol] roles: [statement, anchor] reads: "{statement} is realized by the code at {anchor}" }
  // An anchor the code snapshot contains.
  relation anchor_present { args: [symbol] roles: [anchor] reads: "the code contains {anchor}" }

  // ================================================== approval
  relation link { args: [symbol, symbol] roles: [item, target] reads: "{item} links to {target} now" }
  relation latest_entry { args: [symbol, integer] roles: [item, position] reads: "entry {position} is the latest for {item}" }
  relation live_approval { args: [symbol, symbol, integer, symbol] roles: [item, kind, position, digest] reads: "the latest entry for {item}, at {position}, approves it as a {kind} reading {digest}" }
  relation reinstated { args: [symbol, symbol] roles: [item, kind] reads: "{item} is approved but missing, so it still counts as a {kind}" }
  relation present { args: [symbol, symbol] roles: [item, kind] reads: "{item} counts as a {kind}" }
  relation judged { args: [symbol] roles: [item] reads: "{item} receives a standing" }
  relation link_removed { args: [symbol, symbol] roles: [item, target] reads: "the approved link from {item} to {target} is missing and still counts" }
  relation tag_removed { args: [symbol, symbol] roles: [example, channel] reads: "the approved tag of {example} for {channel} is missing and still counts" }
  relation approval_reason { args: [symbol, symbol, symbol] roles: [item, reason, subject] reads: "{item} is unapproved: {reason} ({subject})" }
  relation unapproved { args: [symbol] roles: [item] reads: "{item} differs from its latest approval" }
  relation stale_link { args: [symbol, symbol] roles: [item, target] reads: "{item} was approved against a reading of {target} that is no longer current or latest approved" }
  relation stale { args: [symbol] roles: [item] reads: "{item} awaits re-confirmation" }
  relation settled { args: [symbol] roles: [item] reads: "{item} is approved as it reads now and is not stale" }
  relation awaiting_approval { args: [symbol] roles: [item] reads: "{item} awaits approval or re-confirmation" }

  // ================================================== evidence per example and channel
  relation effective_link { args: [symbol, symbol] roles: [item, target] reads: "{item} counts as linked to {target}" }
  relation example_of { args: [symbol, symbol] roles: [example, statement] reads: "{example} counts as an example of {statement}" }
  relation example_tag { args: [symbol, symbol] roles: [example, channel] reads: "{example} counts as tagged for {channel}" }
  relation red { args: [symbol, symbol] roles: [example, channel] reads: "{example} failed on {channel} with its current text" }
  relation spoiled { args: [symbol, symbol] roles: [example, channel] reads: "{example} failed or errored on {channel} at the target with its current text" }
  relation green { args: [symbol, symbol] roles: [example, channel] reads: "{example} passes cleanly on {channel} at the target with its current text" }

  // ================================================== applicability and verification
  relation approved_channel { args: [symbol] roles: [channel] reads: "{channel} is an approved channel" }
  relation scoped_out { args: [symbol, symbol] roles: [definition, channel] reads: "a settled exception scopes {definition} out of {channel}" }
  relation applies_on { args: [symbol, symbol] roles: [statement, channel] reads: "{statement} applies on {channel}" }
  relation applies_somewhere { args: [symbol] roles: [statement] reads: "{statement} applies on at least one channel" }
  relation covered_on { args: [symbol, symbol] roles: [statement, channel] reads: "{statement} has an example tagged for {channel}" }
  relation obligation { args: [symbol, symbol, symbol] roles: [statement, example, channel] reads: "{example} must have failed and must pass on {channel} for {statement}" }
  relation channel_gap { args: [symbol, symbol, symbol] roles: [statement, channel, reason] reads: "{statement} lacks evidence on {channel}: {reason}" }
  relation intent_member { args: [symbol, symbol] roles: [intent, member] reads: "{member} must be verified for {intent} to be verified" }
  relation has_member { args: [symbol] roles: [intent] reads: "{intent} has a definition" }
  relation gap { args: [symbol, symbol, symbol] roles: [item, reason, subject] reads: "{item} misses a verification condition: {reason} ({subject})" }
  relation has_gap { args: [symbol] roles: [item] reads: "{item} misses a verification condition" }

  // ================================================== standing and reasons
  relation standing_unapproved { args: [symbol] roles: [item] reads: "{item} stands unapproved" }
  relation standing_stale { args: [symbol] roles: [item] reads: "{item} stands stale" }
  relation standing_unverified { args: [symbol] roles: [item] reads: "{item} stands unverified" }
  relation standing_verified { args: [symbol] roles: [item] reads: "{item} stands verified" }
  relation standing { args: [symbol, symbol] roles: [item, standing] reads: "{item} stands {standing}" }
  relation reason { args: [symbol, symbol, symbol] roles: [item, reason, subject] reads: "{item}'s standing rests on {reason} ({subject})" }

  // ================================================== map
  relation broken_map { args: [symbol, symbol] roles: [statement, anchor] reads: "{statement} names {anchor} as realizing it, but the code does not contain it" }

  // ================================================== rules: approval

  rule link_by_refines { derive: "link(D, I)" when: { refines: "refines(D, I)" } }

  rule link_by_narrows { derive: "link(X, D)" when: { narrows: "narrows(X, D)" } }

  rule link_by_exemplifies { derive: "link(E, S)" when: { exemplifies: "exemplifies(E, S)" } }

  // The last entry per item wins, whatever its action.
  rule find_latest_entry { derive: "latest_entry(I, max(P))" when: { logged: "log_entry(P, I, _, _, _)" } }

  rule find_live_approval { derive: "live_approval(I, K, P, D)" when: { latest: "latest_entry(I, P)" approves: "log_entry(P, I, K, approve, D)" } }

  // An approved item missing now, with no later removal, still counts.
  rule reinstate_missing { derive: "reinstated(I, K)" when: { approved: "live_approval(I, K, _, _)" missing: "!item(I, _)" } }

  rule present_now { derive: "present(I, K)" when: { current: "item(I, K)" } }

  rule present_reinstated { derive: "present(I, K)" when: { reinstated: "reinstated(I, K)" } }

  rule judge_intent { derive: "judged(I)" when: { intent: "present(I, intent)" } }

  rule judge_definition { derive: "judged(D)" when: { definition: "present(D, definition)" } }

  rule judge_exception { derive: "judged(X)" when: { exception: "present(X, exception)" } }

  rule find_removed_link { derive: "link_removed(I, T)" when: { approved: "live_approval(I, _, P, _)" recorded: "log_link(P, T, _)" missing: "!link(I, T)" } }

  rule find_removed_tag { derive: "tag_removed(E, C)" when: { approved: "live_approval(E, _, P, _)" recorded: "log_tag(P, C)" missing: "!tagged(E, C)" } }

  // A latest entry that removes the item leaves a present item without approval.
  rule reason_not_approved { derive: "approval_reason(I, not_approved, I)" when: { current: "item(I, _)" unapproved: "!live_approval(I, _, _, _)" } }

  // Links and tags are inside the digest, so an added link or tag shows here.
  rule reason_text_differs { derive: "approval_reason(I, text_differs, I)" when: { reads_now: "current_digest(I, D)" approved_as: "live_approval(I, _, _, A)" differs: "D \\= A" } }

  rule reason_removal { derive: "approval_reason(I, removal_pending, I)" when: { reinstated: "reinstated(I, _)" } }

  rule reason_link_removal { derive: "approval_reason(I, link_removal_pending, T)" when: { removed: "link_removed(I, T)" current: "item(I, _)" } }

  rule reason_tag_removal { derive: "approval_reason(E, tag_removal_pending, C)" when: { removed: "tag_removed(E, C)" current: "item(E, _)" } }

  rule find_unapproved { derive: "unapproved(I)" when: { reason: "approval_reason(I, _, _)" } }

  // Stale when a linked statement's current digest differs from the recorded one,
  rule stale_by_current_text { derive: "stale_link(I, T)" when: { approved: "live_approval(I, _, P, _)" recorded: "log_link(P, T, R)" reads_now: "current_digest(T, D)" differs: "D \\= R" } }

  // or its latest approved digest does, so reverting the dependency does not clear staleness.
  rule stale_by_latest_approval { derive: "stale_link(I, T)" when: { approved: "live_approval(I, _, P, _)" recorded: "log_link(P, T, R)" approved_as: "live_approval(T, _, _, A)" differs: "A \\= R" } }

  rule find_stale { derive: "stale(I)" when: { link: "stale_link(I, _)" } }

  rule find_settled { derive: "settled(I)" when: { current: "item(I, _)" approved: "!unapproved(I)" fresh: "!stale(I)" } }

  rule await_unapproved { derive: "awaiting_approval(I)" when: { unapproved: "unapproved(I)" } }

  rule await_stale { derive: "awaiting_approval(I)" when: { stale: "stale(I)" } }

  // ================================================== rules: evidence per example and channel

  rule link_now { derive: "effective_link(I, T)" when: { link: "link(I, T)" } }

  rule link_pending_removal { derive: "effective_link(I, T)" when: { removed: "link_removed(I, T)" } }

  rule find_example_of { derive: "example_of(E, S)" when: { link: "effective_link(E, S)" example: "present(E, example)" } }

  rule tag_now { derive: "example_tag(E, C)" when: { tagged: "tagged(E, C)" } }

  rule tag_pending_removal { derive: "example_tag(E, C)" when: { removed: "tag_removed(E, C)" } }

  // A fail with the current text at any source identity; error and skip never count.
  rule find_red { derive: "red(E, C)" when: { reads_now: "current_digest(E, D)" failed: "run(E, D, C, _, fail)" } }

  rule spoil_by_failure { derive: "spoiled(E, C)" when: { reads_now: "current_digest(E, D)" failed: "run(E, D, C, T, fail)" at_target: "target_identity(T)" } }

  rule spoil_by_error { derive: "spoiled(E, C)" when: { reads_now: "current_digest(E, D)" errored: "run(E, D, C, T, error)" at_target: "target_identity(T)" } }

  rule find_green { derive: "green(E, C)" when: { reads_now: "current_digest(E, D)" passed: "run(E, D, C, T, pass)" at_target: "target_identity(T)" clean: "!spoiled(E, C)" } }

  // ================================================== rules: applicability and verification

  // A channel stays approved through text edits and a pending removal until its removal is approved.
  rule find_approved_channel { derive: "approved_channel(C)" when: { approved: "live_approval(C, channel, _, _)" } }

  rule scope_out { derive: "scoped_out(D, C)" when: { narrows: "narrows(X, D)" scope: "scoped_to(X, C)" settled: "settled(X)" } }

  // Every approved channel unless a settled exception scopes it out.
  rule definition_applies { derive: "applies_on(D, C)" when: { definition: "present(D, definition)" approved: "approved_channel(C)" not_scoped_out: "!scoped_out(D, C)" } }

  rule exception_applies { derive: "applies_on(X, C)" when: { holds_instead: "exception_kind(X, holds_instead)" scope: "scoped_to(X, C)" } }

  rule find_applies_somewhere { derive: "applies_somewhere(S)" when: { applies: "applies_on(S, _)" } }

  rule cover_channel { derive: "covered_on(S, C)" when: { example: "example_of(E, S)" tag: "example_tag(E, C)" } }

  rule find_obligation { derive: "obligation(S, E, C)" when: { applies: "applies_on(S, C)" example: "example_of(E, S)" tag: "example_tag(E, C)" } }

  rule gap_no_example { derive: "channel_gap(S, C, no_example)" when: { applies: "applies_on(S, C)" uncovered: "!covered_on(S, C)" } }

  rule gap_no_failing_run { derive: "channel_gap(S, C, no_failing_run)" when: { owed: "obligation(S, E, C)" not_red: "!red(E, C)" } }

  rule gap_no_passing_run { derive: "channel_gap(S, C, no_passing_run)" when: { owed: "obligation(S, E, C)" not_green: "!green(E, C)" } }

  rule gap_on_channel { derive: "gap(S, R, C)" when: { channel_gap: "channel_gap(S, C, R)" } }

  rule gap_no_channel { derive: "gap(D, no_channel, D)" when: { definition: "present(D, definition)" nowhere: "!applies_somewhere(D)" } }

  // A settled exception would have scoped the channel out, so one naming a channel with a gap is unsettled.
  rule gap_exception_unsettled { derive: "gap(D, exception_unsettled, X)" when: { narrows: "narrows(X, D)" scope: "scoped_to(X, C)" channel_gap: "channel_gap(D, C, _)" } }

  rule gap_example_awaits_approval { derive: "gap(S, example_awaits_approval, E)" when: { example: "example_of(E, S)" unsettled: "!settled(E)" } }

  rule gap_run_digest_mismatch { derive: "gap(S, run_digest_mismatch, E)" when: { owed: "obligation(S, E, C)" failed: "run(E, _, C, _, fail)" not_red: "!red(E, C)" } }

  rule gap_dependent_removal { derive: "gap(T, dependent_removal_pending, I)" when: { removed: "link_removed(I, T)" } }

  // An intent needs every definition refining it and every exception narrowing those.
  rule member_definition { derive: "intent_member(I, D)" when: { link: "effective_link(D, I)" intent: "present(I, intent)" } }

  rule member_exception { derive: "intent_member(I, X)" when: { member: "intent_member(I, D)" link: "effective_link(X, D)" exception: "present(X, exception)" } }

  rule find_has_member { derive: "has_member(I)" when: { member: "intent_member(I, _)" } }

  rule gap_no_definition { derive: "gap(I, no_definition, I)" when: { intent: "present(I, intent)" empty: "!has_member(I)" } }

  rule gap_unsettled_member { derive: "gap(I, unverified_member, M)" when: { member: "intent_member(I, M)" unsettled: "!settled(M)" } }

  rule gap_member_gap { derive: "gap(I, unverified_member, M)" when: { member: "intent_member(I, M)" gap: "has_gap(M)" } }

  rule find_has_gap { derive: "has_gap(S)" when: { gap: "gap(S, _, _)" } }

  // ================================================== rules: standing and reasons

  rule stand_unapproved { derive: "standing_unapproved(I)" when: { judged: "judged(I)" unapproved: "unapproved(I)" } }

  rule stand_stale { derive: "standing_stale(I)" when: { judged: "judged(I)" stale: "stale(I)" approved: "!unapproved(I)" } }

  rule stand_unverified { derive: "standing_unverified(I)" when: { settled: "settled(I)" gap: "has_gap(I)" } }

  rule stand_verified { derive: "standing_verified(I)" when: { judged: "judged(I)" settled: "settled(I)" complete: "!has_gap(I)" } }

  rule standing_is_unapproved { derive: "standing(I, unapproved)" when: { standing: "standing_unapproved(I)" } }

  rule standing_is_stale { derive: "standing(I, stale)" when: { standing: "standing_stale(I)" } }

  rule standing_is_unverified { derive: "standing(I, unverified)" when: { standing: "standing_unverified(I)" } }

  rule standing_is_verified { derive: "standing(I, verified)" when: { standing: "standing_verified(I)" } }

  rule reason_for_unapproved { derive: "reason(I, R, S)" when: { standing: "standing_unapproved(I)" reason: "approval_reason(I, R, S)" } }

  rule reason_for_stale { derive: "reason(I, linked_statement_changed, T)" when: { standing: "standing_stale(I)" link: "stale_link(I, T)" } }

  rule reason_for_unverified { derive: "reason(I, R, S)" when: { standing: "standing_unverified(I)" gap: "gap(I, R, S)" } }


  // ================================================== rules: map

  rule find_broken_map { derive: "broken_map(S, A)" when: { realized: "realized(S, A)" absent: "!anchor_present(A)" } }

  // ================================================== fixture

  // Approved channels are shared by every case: browser, mcp and public.
  // kiosk was added but never approved, so it applies to nothing and awaits approval.

  fact fixture_channels_0 { relation: item args: [browser, channel] }
  fact fixture_channels_1 { relation: current_digest args: [browser, h_browser] }
  fact fixture_channels_2 { relation: log_entry args: [1, browser, channel, approve, h_browser] }
  fact fixture_channels_3 { relation: item args: [mcp, channel] }
  fact fixture_channels_4 { relation: current_digest args: [mcp, h_mcp] }
  fact fixture_channels_5 { relation: log_entry args: [2, mcp, channel, approve, h_mcp] }
  fact fixture_channels_6 { relation: item args: [public, channel] }
  fact fixture_channels_7 { relation: current_digest args: [public, h_public] }
  fact fixture_channels_8 { relation: log_entry args: [3, public, channel, approve, h_public] }
  fact fixture_channels_9 { relation: item args: [kiosk, channel] }
  fact fixture_channels_10 { relation: current_digest args: [kiosk, h_kiosk] }
  fact fixture_channels_11 { relation: target_identity args: [t_head] }

  // Case ae1 and ae10. Approved, never edited examples failed and now pass on every
  // approved channel. The browser example failed on an earlier commit; the MCP example
  // failed only on a scratch break of a tool that already worked (ae10).

  fact fixture_ae1_0 { relation: item args: [ae1_intent, intent] }
  fact fixture_ae1_1 { relation: current_digest args: [ae1_intent, h_ae1_intent] }
  fact fixture_ae1_2 { relation: log_entry args: [10, ae1_intent, intent, approve, h_ae1_intent] }
  fact fixture_ae1_3 { relation: item args: [ae1_def, definition] }
  fact fixture_ae1_4 { relation: current_digest args: [ae1_def, h_ae1_def] }
  fact fixture_ae1_5 { relation: refines args: [ae1_def, ae1_intent] }
  fact fixture_ae1_6 { relation: log_entry args: [11, ae1_def, definition, approve, h_ae1_def] }
  fact fixture_ae1_7 { relation: log_link args: [11, ae1_intent, h_ae1_intent] }
  fact fixture_ae1_8 { relation: item args: [ae1_ex_web, example] }
  fact fixture_ae1_9 { relation: current_digest args: [ae1_ex_web, h_ae1_ex_web] }
  fact fixture_ae1_10 { relation: exemplifies args: [ae1_ex_web, ae1_def] }
  fact fixture_ae1_11 { relation: tagged args: [ae1_ex_web, browser] }
  fact fixture_ae1_12 { relation: tagged args: [ae1_ex_web, public] }
  fact fixture_ae1_13 { relation: log_entry args: [12, ae1_ex_web, example, approve, h_ae1_ex_web] }
  fact fixture_ae1_14 { relation: log_link args: [12, ae1_def, h_ae1_def] }
  fact fixture_ae1_15 { relation: log_tag args: [12, browser] }
  fact fixture_ae1_16 { relation: log_tag args: [12, public] }
  fact fixture_ae1_17 { relation: run args: [ae1_ex_web, h_ae1_ex_web, browser, t_old, fail] }
  fact fixture_ae1_18 { relation: run args: [ae1_ex_web, h_ae1_ex_web, public, t_old, fail] }
  fact fixture_ae1_19 { relation: run args: [ae1_ex_web, h_ae1_ex_web, browser, t_head, pass] }
  fact fixture_ae1_20 { relation: run args: [ae1_ex_web, h_ae1_ex_web, public, t_head, pass] }
  fact fixture_ae1_21 { relation: item args: [ae1_ex_mcp, example] }
  fact fixture_ae1_22 { relation: current_digest args: [ae1_ex_mcp, h_ae1_ex_mcp] }
  fact fixture_ae1_23 { relation: exemplifies args: [ae1_ex_mcp, ae1_def] }
  fact fixture_ae1_24 { relation: tagged args: [ae1_ex_mcp, mcp] }
  fact fixture_ae1_25 { relation: log_entry args: [13, ae1_ex_mcp, example, approve, h_ae1_ex_mcp] }
  fact fixture_ae1_26 { relation: log_link args: [13, ae1_def, h_ae1_def] }
  fact fixture_ae1_27 { relation: log_tag args: [13, mcp] }
