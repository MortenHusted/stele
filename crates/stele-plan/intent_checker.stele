  // ================================================== expectations

  // Shared channels.

  expect three_channels_are_approved { query: "approved_channel(C)" count: 3 }
  expect unapproved_channel_does_not_apply { query: "approved_channel(kiosk)" count: 0 }
  expect new_channel_awaits_approval { query: "approval_reason(kiosk, not_approved, kiosk)" count: 1 }
  expect channels_have_no_standing { query: "standing(browser, K)" count: 0 }

  // Case ae1 and ae10.

  expect ae1_intent_has_one_standing { query: "standing(ae1_intent, K)" count: 1 }
  expect ae1_intent_is_verified { query: "standing(ae1_intent, verified)" count: 1 }
  expect ae1_def_has_one_standing { query: "standing(ae1_def, K)" count: 1 }
  expect ae1_def_is_verified { query: "standing(ae1_def, verified)" count: 1 }
  expect ae1_intent_has_0_reasons { query: "reason(ae1_intent, R, S)" count: 0 }
  expect ae1_def_has_0_reasons { query: "reason(ae1_def, R, S)" count: 0 }
  expect ae1_web_failed_on_two_channels { query: "red(ae1_ex_web, C)" count: 2 }
  expect ae1_web_passes_on_two_channels { query: "green(ae1_ex_web, C)" count: 2 }
  expect ae10_scratch_failure_counts_as_red { query: "red(ae1_ex_mcp, mcp)" count: 1 }
  expect ae10_mcp_example_passes { query: "green(ae1_ex_mcp, mcp)" count: 1 }
  expect ae1_owes_three_example_channels { query: "obligation(ae1_def, E, C)" count: 3 }
  expect ae1_web_owes_nothing_on_mcp { query: "obligation(ae1_def, ae1_ex_web, mcp)" count: 0 }

  // Case ae2.

  expect ae2_intent_has_one_standing { query: "standing(ae2_intent, K)" count: 1 }
  expect ae2_intent_is_unverified { query: "standing(ae2_intent, unverified)" count: 1 }
  expect ae2_def_has_one_standing { query: "standing(ae2_def, K)" count: 1 }
  expect ae2_def_is_unverified { query: "standing(ae2_def, unverified)" count: 1 }
  expect ae2_edited_example_is_unapproved { query: "approval_reason(ae2_ex, text_differs, ae2_ex)" count: 1 }
